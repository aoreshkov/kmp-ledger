<?xml version="1.0" encoding="utf-8"?>
<!--
  Disables all data extraction on Android 12+ (API 31+), where allowBackup no
  longer governs device-to-device transfer. Excludes every domain from both
  cloud backup and device transfer so the local ledger DB never leaves the app
  sandbox. Pre-12 backup is already disabled by android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
