<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 (API < 31) counterpart to data_extraction_rules.xml. Excludes
  every domain so the local ledger DB is never included in cloud or adb backups.
  Backup is already off via android:allowBackup="false"; this keeps the rules
  explicit and silences lint's DataExtractionRules check for minSdk 24.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
